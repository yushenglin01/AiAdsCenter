# Local demo defaults only. Generate unique values before any shared or public deployment.
GAI_ENVIRONMENT=development
GAI_DEMO_SEED=true
MYSQL_PASSWORD=gai_local_password
MYSQL_ROOT_PASSWORD=root_local_password
MYSQL_PORT=3306
REDIS_PORT=6379
API_PORT=8080
WEB_PORT=5173
JWT_SECRET=replace-with-at-least-32-random-characters
GAI_TENANT_DEFAULT_ID=00000000-0000-4000-8000-000000000001
GAI_DATABASE_MIGRATION_DIR=migrations

# Internal member registration. Production must use HTTPS, SMTP and company domain allowlisting.
GAI_REGISTRATION_ENABLED=true
GAI_REGISTRATION_PUBLIC_BASE_URL=http://localhost:5173
GAI_REGISTRATION_VERIFICATION_TTL=24h
GAI_REGISTRATION_RESEND_COOLDOWN=2m
GAI_REGISTRATION_ALLOWED_EMAIL_DOMAINS=
GAI_REGISTRATION_MAIL_PROVIDER=log
GAI_REGISTRATION_MAIL_SMTP_ADDRESS=
GAI_REGISTRATION_MAIL_SMTP_USERNAME=
GAI_REGISTRATION_MAIL_SMTP_PASSWORD=
GAI_REGISTRATION_MAIL_FROM_ADDRESS=no-reply@adnova.local
GAI_REGISTRATION_MAIL_FROM_NAME=AdNova

# Defaults to deterministic Mock. Switch provider only after configuring all real model values.
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=mock-business-v1
GAI_LLM_SCHEMA_DIR=configs/schemas

# Asynq business-analysis queue. API dispatches; worker consumes and retries.
GAI_QUEUE_NAME=business-analysis
GAI_QUEUE_CONCURRENCY=4
GAI_QUEUE_MAX_RETRY=3
GAI_QUEUE_TASK_TIMEOUT=2m
GAI_QUEUE_RETENTION=24h
GAI_QUEUE_DISPATCH_INTERVAL=2s
GAI_QUEUE_SHUTDOWN_TIMEOUT=30s

# AppsFlyer Raw Data Pull API v5. Token stays server-side and is never returned by the API.
GAI_APPSFLYER_BASE_URL=https://hq1.appsflyer.com
GAI_APPSFLYER_API_TOKEN=
GAI_APPSFLYER_TIMEOUT=8s
GAI_APPSFLYER_MAX_RETRIES=2
GAI_APPSFLYER_PURCHASE_EVENTS=af_purchase
GAI_APPSFLYER_MAX_RANGE_DAYS=7

# Adjust Report Service API. Event metric slugs come from the Adjust Events/Filters APIs.
GAI_ADJUST_BASE_URL=https://automate.adjust.com
GAI_ADJUST_API_TOKEN=
GAI_ADJUST_ACTIVATION_METRIC=
GAI_ADJUST_PAYER_METRIC=
GAI_ADJUST_REVENUE_METRIC=
GAI_ADJUST_TIMEOUT=8s
GAI_ADJUST_MAX_RETRIES=2
GAI_ADJUST_MAX_RANGE_DAYS=31

# Daily rolling MMP reconciliation. Disabled until a real provider is configured and verified.
GAI_MMP_AUTO_SYNC_ENABLED=false
GAI_MMP_AUTO_SYNC_INTERVAL=1h
GAI_MMP_AUTO_SYNC_LOOKBACK_DAYS=3

# Real-time public web research through Brave Search API. The key remains server-side.
# Enable import only when the selected Brave plan grants search-result storage rights.
GAI_WEB_SEARCH_PROVIDER=brave
GAI_WEB_SEARCH_BASE_URL=https://api.search.brave.com
GAI_WEB_SEARCH_API_KEY=
GAI_WEB_SEARCH_TIMEOUT=8s
GAI_WEB_SEARCH_MAX_RESULTS=8
GAI_WEB_SEARCH_SAFE_SEARCH=strict
GAI_WEB_SEARCH_IMPORT_ENABLED=false

# Optional Kafka ingestion worker. Start with: docker compose --profile kafka up -d --build
GAI_KAFKA_ENABLED=false
GAI_KAFKA_BROKERS=
GAI_KAFKA_TOPICS=adnova.ingestion.ad-metrics.v1,adnova.ingestion.mmp-metrics.v1,adnova.ingestion.game-revenue.v1,adnova.ingestion.creative-metrics.v1
GAI_KAFKA_GROUP_ID=adnova-ingestion-v1
GAI_KAFKA_DLQ_TOPIC=adnova.ingestion.dlq.v1
GAI_KAFKA_TENANT_ID=
GAI_KAFKA_PRODUCER_SYSTEM=
GAI_KAFKA_USERNAME=
GAI_KAFKA_PASSWORD=
GAI_KAFKA_TLS_ENABLED=true
GAI_KAFKA_DEBOUNCE=60s
GAI_KAFKA_MESSAGE_LEASE=5m
GAI_KAFKA_ANALYSIS_LEASE=15m
GAI_KAFKA_PROCESS_RETRIES=3
